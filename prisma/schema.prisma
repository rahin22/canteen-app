generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  STUDENT
  PARENT
}

enum CardType {
  QR
  NFC
}

enum CardStatus {
  ACTIVE
  BLOCKED
  REPLACED
}

enum TxType {
  TOPUP_CASH
  TOPUP_STRIPE
  PURCHASE
  ADJUSTMENT
  // Reverses a purchase that never became food — currently only a cancelled
  // preorder. Kept separate from ADJUSTMENT because it nets off the daily
  // spend cap, whereas an admin adjustment deliberately doesn't.
  REFUND
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum PreorderStatus {
  PENDING
  COLLECTED
  CANCELLED
}

/**
 * Where an order was placed — the office kiosk, a parent's own login, or a
 * staff member taking it at the counter on a student's behalf.
 */
enum PreorderSource {
  KIOSK
  PARENT
  STAFF
}

model User {
  id           String   @id @default(cuid())
  role         Role     @default(STUDENT)
  name         String
  username     String   @unique
  passwordHash String
  className    String?
  // Which school this person belongs to. Always set for students — it decides
  // whose menu they see and which admin filter they appear under. Left null
  // for admins and parents, who aren't tied to one (a parent may well have
  // children at both).
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId     String?
  // Contact details, only collected for self-registered PARENT accounts.
  // Students and operators sign in with a school-issued username and have no
  // email, so the email-based flows never apply to them.
  email           String?
  phone           String?
  emailVerifiedAt DateTime?
  // Bumped whenever the password changes. The value is baked into the session
  // cookie, so every existing session stops working after a reset.
  sessionVersion  Int       @default(0)
  codes           VerificationCode[]
  // Cached balance in cents. Source of truth is the Transaction ledger;
  // every write to balance happens atomically alongside a Transaction row.
  balance      Int      @default(0)
  // Optional cap on how much this student may spend per day, in cents. Set by
  // a linked parent. null means no cap; 0 means no spending at all. Enforced
  // in chargeStudent against purchases made since the start of the local day.
  dailyLimit   Int?
  active       Boolean  @default(true)
  cards        Card[]
  transactions Transaction[] @relation("StudentTx")
  operated     Transaction[] @relation("OperatorTx")
  preorders    Preorder[]    @relation("StudentPreorders")
  placedPreorders Preorder[] @relation("PlacedPreorders")
  // PARENT accounts link to their STUDENT children (and vice versa).
  children     User[]   @relation("ParentChild")
  parents      User[]   @relation("ParentChild")
  // Identification photo (students only). See Photo — stored encrypted.
  photo        Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  photoId      String?  @unique
  // Registrations this parent submitted, and the one that created this student.
  submittedRegistrations ChildRegistration[] @relation("ParentRegistrations")
  reviewedRegistrations  ChildRegistration[] @relation("ReviewerRegistrations")
  registration           ChildRegistration?  @relation("RegisteredStudent")
  createdAt    DateTime @default(now())
}

/**
 * Identification photos of children — sensitive personal data.
 *
 * `data` holds AES-256-GCM ciphertext (see src/lib/photos.ts), so a leaked
 * database dump does not expose the images. Photos are only ever served
 * through /api/photo/... which authorises every request; they are never
 * written to disk or exposed on a public URL. Images are re-encoded on
 * upload, which strips EXIF — including GPS coordinates.
 */
model Photo {
  id           String  @id @default(cuid())
  data         Bytes
  mimeType     String
  byteSize     Int
  user         User?
  registration ChildRegistration?
  createdAt    DateTime @default(now())
}

/**
 * A child a parent has registered through the public signup flow. Nothing is
 * created in the canteen system until an admin approves it — self-signup on
 * its own can never mint a student account or a card.
 */
model ChildRegistration {
  id         String             @id @default(cuid())
  parent     User               @relation("ParentRegistrations", fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String
  name       String
  // School-issued student ID; becomes the student's username on approval.
  // Named for the ID printed on the card, not the School relation below.
  studentIdCode String
  // Which school the parent is enrolling the child at.
  school     School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId   String?
  className  String?
  photo      Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  photoId    String?            @unique
  status     RegistrationStatus @default(PENDING)
  note       String?
  // Audit trail: who actioned this and when.
  reviewer   User?              @relation("ReviewerRegistrations", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerId String?
  reviewedAt DateTime?
  // The student account this registration resolved to, once approved.
  student    User?              @relation("RegisteredStudent", fields: [studentId], references: [id], onDelete: SetNull)
  studentId  String?            @unique
  createdAt  DateTime           @default(now())

  @@index([status, createdAt])
  @@index([parentId])
}

/**
 * One-time codes emailed to a parent to confirm their address or reset their
 * password. Only a bcrypt hash of the code is stored, codes expire quickly,
 * and `attempts` caps guessing — six digits is only a million combinations,
 * so the attempt limit is what actually makes them safe.
 */
model VerificationCode {
  id         String              @id @default(cuid())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/**
 * A school the canteen system serves.
 *
 * One deployment runs several schools side by side. Students, menus and
 * registrations each belong to exactly one; admins switch between them (or
 * view all at once) from the header. Schools are deactivated rather than
 * deleted so historical students and transactions keep their affiliation.
 */
model School {
  id            String              @id @default(cuid())
  name          String
  active        Boolean             @default(true)
  sortOrder     Int                 @default(0)
  users         User[]
  menuItems     MenuItem[]
  registrations ChildRegistration[]
  pickupSlots   PickupSlot[]
  createdAt     DateTime            @default(now())
}

/**
 * A window during the school day when preordered food can be collected —
 * "Primary Lunch, 1:10pm–1:50pm" and so on.
 *
 * Per school, because the two schools ring their bells at different times.
 * Times are stored as local "HH:MM" strings rather than DateTimes: they're a
 * repeating fact about the timetable, not an instant, and storing them as
 * dates would drag timezone conversion into something that never moves.
 */
model PickupSlot {
  id        String     @id @default(cuid())
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  label     String
  startTime String
  endTime   String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  preorders Preorder[]
  createdAt DateTime   @default(now())

  @@index([schoolId, active])
}

/** Simple key/value app settings editable by an admin at /admin/settings. */
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Card {
  id        String     @id @default(cuid())
  token     String     @unique
  type      CardType   @default(QR)
  status    CardStatus @default(ACTIVE)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@index([userId])
}

model MenuItem {
  id        String  @id @default(cuid())
  name      String
  price     Int
  category  String?
  active    Boolean @default(true)
  // Temporarily unavailable — the kitchen ran out. Distinct from `active`,
  // which means "not on the menu at all": sold-out is an everyday switch the
  // canteen flips back tomorrow, and keeping them separate means doing so
  // doesn't disturb how the item is set up.
  soldOut   Boolean @default(false)
  sortOrder Int     @default(0)
  // Menus are per-school. The two schools run similar lists, but they price
  // and stock them independently, so an item belongs to exactly one.
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String

  @@index([schoolId, active])
}

model Transaction {
  id              String   @id @default(cuid())
  type            TxType
  // Signed cents: top-ups positive, purchases negative.
  amount          Int
  student         User     @relation("StudentTx", fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  operator        User?    @relation("OperatorTx", fields: [operatorId], references: [id], onDelete: SetNull)
  operatorId      String?
  items           Json?
  note            String?
  stripeSessionId String?  @unique
  preorder        Preorder?
  createdAt       DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([createdAt])
}

/**
 * A meal ordered ahead of time — from the office kiosk at the start of the day
 * or by a parent from their own login — and collected at the canteen later.
 *
 * Preorders carry no money. Nothing is deducted when one is placed; the till
 * charges it on collection through the normal ledger path, so the balance
 * check and the parent's daily spend cap are applied at the moment of sale
 * rather than being second-guessed hours earlier. That also means cancelling
 * an order never needs a refund.
 */
model Preorder {
  id         String         @id @default(cuid())
  student    User           @relation("StudentPreorders", fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  // Who placed it. Null for kiosk orders: tapping a card at the kiosk
  // identifies the student but never signs anybody in, so there's no actor
  // beyond the student the card belongs to.
  placedBy   User?          @relation("PlacedPreorders", fields: [placedById], references: [id], onDelete: SetNull)
  placedById String?
  source     PreorderSource
  // Snapshot of the lines and the prices quoted at order time. The till
  // charges these rather than live menu prices, so editing the menu can't
  // change what a child was quoted or strand an order whose item was removed.
  items      Json
  total      Int
  status     PreorderStatus @default(PENDING)
  // Local midnight of the canteen day the order is for (see src/lib/day.ts).
  // Orders placed after the cutoff are for the *next* school day, so this is
  // not always the day the order was created.
  serviceDate DateTime
  // When the student will collect it. Optional so orders taken before pickup
  // slots existed still load.
  pickupSlot   PickupSlot? @relation(fields: [pickupSlotId], references: [id], onDelete: SetNull)
  pickupSlotId String?
  // The purchase that fulfilled this order, once it's been collected.
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId String?      @unique
  collectedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([serviceDate, status])
  @@index([studentId, serviceDate])
}
