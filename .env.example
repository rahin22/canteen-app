# Copy to .env and fill in.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
SESSION_SECRET="generate-a-long-random-string"

# Encrypts student ID photos at rest. Generate with: openssl rand -hex 32
# Losing or changing this makes existing photos unreadable (they can be
# re-uploaded). Keep it out of version control and back it up with the DB.
PHOTO_ENCRYPTION_KEY="64-hex-characters"

# Email (Resend). Leave both empty to run without email entirely: parents skip
# address confirmation and admins reset passwords by hand. Setting them only
# makes the feature available — an admin still turns it on in Admin → Settings.
# Note that Railway blocks outbound SMTP below the Pro plan, so this has to be
# an HTTPS API like Resend rather than an SMTP server.
RESEND_API_KEY="re_..."
EMAIL_FROM="School Canteen <canteen@yourschool.edu.au>"

# Stripe (leave empty to disable online top-ups)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public app URL (used for Stripe redirect URLs)
APP_URL="http://localhost:3000"

# IANA timezone the school actually operates in. Decides when "today" rolls
# over for daily spending limits — on a UTC server an Australian school would
# otherwise reset the cap mid-lunch. Defaults to Australia/Sydney.
SCHOOL_TIMEZONE="Australia/Sydney"

NEXT_PUBLIC_SCHOOL_NAME="School Canteen"
# ISO 4217 currency code used for display and Stripe charges
NEXT_PUBLIC_CURRENCY="AUD"
# BCP 47 locale used for currency/date formatting
NEXT_PUBLIC_LOCALE="en-AU"
